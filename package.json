{
  "name": "kusi-qumir-workspace",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "scripts": {
    "start": "node scripts/dev.mjs",
    "build": "pnpm --dir frontend build",
    "test:ci": "node --test scripts/launch.test.mjs && pnpm --dir frontend test:ci",
    "serve:ssr": "pnpm --dir frontend serve:ssr",
    "frontend:start": "pnpm --dir frontend start",
    "frontend:build": "pnpm --dir frontend build",
    "frontend:test": "pnpm --dir frontend test:ci",
    "backend:start": "pnpm --dir backend start:dev",
    "backend:build": "pnpm --dir backend build",
    "backend:lint": "pnpm --dir backend lint",
    "backend:test": "pnpm --dir backend test",
    "db:start": "docker compose -f compose.dev.yaml up -d postgres",
    "db:stop": "docker compose -f compose.dev.yaml stop postgres",
    "build:all": "pnpm frontend:build && pnpm backend:build",
    "test:all": "pnpm frontend:test && pnpm backend:test",
    "build:pages": "node scripts/build-pages.mjs"
  }
}
